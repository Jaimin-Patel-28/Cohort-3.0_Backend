      "text": "For read req data which is send from frontend we use \"USE\" method\nbecause express did not know how to catch text data in req. For this \nwe use middlewere(USE method ) which is \"express.json()\" inside the\napp.use",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For read req data which is send from frontend we use \"USE\" method\nbecause express did not know how to catch text data in req. For this \nwe use middlewere(USE method ) which is \"express.json()\" inside the\napp.use",
      "autoResize": true,
      "lineHeight": 1.25
    },
