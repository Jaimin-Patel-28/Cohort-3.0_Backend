        }
      ],
      "updated": 1787207504990,
      "link": null,
      "locked": false,
      "text": "let users = [];\n\napp.use(express.json());\n\n//create\napp.post(\"/\", (req, res) => {\n  let body = req.body;\n  users.push(body);\n\n  res.send(\"data created\", users);\n});\n\n//read\napp.get(\"/users\", (req, res) => {\n  res.send(users);\n});\n\n//delete\napp.delete(\"/users/:id\", (req, res) => {\n  let { id } = req.params;\n  let userData = users.filter((val) => {\n    console.log(val);\n    return val.id !== id;\n  });\n  users = userData;\n  res.send(userData);\n});",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let users = [];\n\napp.use(express.json());\n\n//create\napp.post(\"/\", (req, res) => {\n  let body = req.body;\n  users.push(body);\n\n  res.send(\"data created\", users);\n});\n\n//read\napp.get(\"/users\", (req, res) => {\n  res.send(users);\n});\n\n//delete\napp.delete(\"/users/:id\", (req, res) => {\n  let { id } = req.params;\n  let userData = users.filter((val) => {\n    console.log(val);\n    return val.id !== id;\n  });\n  users = userData;\n  res.send(userData);\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
