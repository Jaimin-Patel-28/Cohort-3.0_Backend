      "roundness": null,
      "seed": 1927799834,
      "version": 216,
      "versionNonce": 1425256006,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "CVZHKcIfGjp2uMAs28NnQ",
          "type": "arrow"
        },
        {
          "id": "IlD2QSSzTiR_-2e6S1j9I",
